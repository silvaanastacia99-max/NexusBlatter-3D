Update index.html
index.html<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<meta name="theme-color" content="#101c25">
<title>NexusBlatter 3D - Anime Battle Royale</title>
<style>
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#101c25;color:#fff;font-family:Arial;touch-action:none}
canvas{display:block}
#hud{position:fixed;top:9px;left:9px;right:9px;z-index:5;display:flex;justify-content:space-between;gap:8px;pointer-events:none}
.painel{background:#101923dd;border:1px solid #ffffff55;border-radius:12px;padding:9px;font-size:12px;text-shadow:0 1px 2px #000}
#barraFundo{width:110px;height:11px;background:#555;border-radius:20px;overflow:hidden;margin:5px 0}
#barraVida{height:100%;width:100%;background:#25ed65;transition:width .2s}
#minimap{position:fixed;right:10px;top:100px;width:90px;height:90px;border-radius:50%;background:#10202dcc;border:1px solid #ffffff66;z-index:4;pointer-events:none}
#dica{position:fixed;right:10px;bottom:105px;z-index:5;font-size:10px;opacity:.8;pointer-events:none;text-shadow:0 1px 3px #000}
#controles{position:fixed;bottom:16px;left:0;right:0;z-index:8;display:flex;justify-content:space-between;align-items:flex-end;padding:0 15px;pointer-events:none}
#joystick{width:120px;height:120px;border-radius:50%;background:#ffffff20;border:2px solid #ffffff80;position:relative;pointer-events:auto;touch-action:none}
#bola{width:52px;height:52px;border-radius:50%;background:#ffffffbb;border:2px solid white;position:absolute;left:32px;top:32px;pointer-events:none}
#botoes{display:flex;gap:8px;align-items:flex-end;pointer-events:auto}
.btn{width:58px;height:58px;border-radius:50%;border:2px solid #ffffffaa;background:#172d48ee;color:white;font-size:18px;font-weight:bold;touch-action:none}
#atacar{width:76px;height:76px;background:#d93c45ee;border-color:#ffb0a0;font-size:12px}
#pular{background:#246d9bee}#especial{background:#6337aeee;border-color:#d5aaff;font-size:11px}
#mensagem{position:fixed;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;background:#07111bee;padding:14px;overflow-y:auto}
#caixa{width:min(390px,96%);max-height:95%;overflow-y:auto;padding:20px;border-radius:20px;text-align:center;background:linear-gradient(145deg,#193b52,#101626);border:1px solid #5edaff88;box-shadow:0 0 35px #00bfff33}
#caixa h1{color:#55e5ff;font-size:25px;margin:5px}#caixa p{font-size:13px;line-height:1.5;color:#dceaf5}
#seletores{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin:15px 0}
.heroi{border:1px solid #ffffff55;border-radius:12px;padding:9px;background:#ffffff12;color:white;font-size:12px;min-height:72px}
.heroi.selecionado{border:2px solid #42eaff;background:#167a9a55}
.heroi strong{display:block;font-size:14px;margin-bottom:5px}
#jogar{padding:14px 23px;border:0;border-radius:12px;color:#061522;font-weight:bold;font-size:16px;background:linear-gradient(90deg,#37e9ff,#42ff9b);width:100%}
#aviso{position:fixed;top:45%;left:50%;transform:translate(-50%,-50%);z-index:15;background:#142e4aee;padding:13px 20px;border-radius:12px;display:none;text-align:center;max-width:85%;font-size:13px}
@media(max-height:520px){#joystick{width:94px;height:94px}#bola{left:21px;top:21px}#controles{bottom:8px}#dica{bottom:85px}.btn{width:50px;height:50px}#atacar{width:64px;height:64px}}
</style>
</head>
<body>
<div id="hud">
 <div class="painel"><b>NEXUSBLATTER</b><br><span id="personagemNome">Herói: Nexus</span><br><span id="pontos">Pontos: 0</span><br><span id="inimigosTexto">Inimigos: 6</span></div>
 <div class="painel">VIDA<div id="barraFundo"><div id="barraVida"></div></div><span id="vidaTexto">100 / 100</span></div>
</div>
<canvas id="minimap" width="180" height="180"></canvas>
<div id="dica">Arraste o lado direito para girar a câmera</div>
<div id="controles">
 <div id="joystick"><div id="bola"></div></div>
 <div id="botoes"><button class="btn" id="pular">↑</button><button class="btn" id="especial">PODER</button><button class="btn" id="atacar">ENERGIA</button></div>
</div>
<div id="mensagem"><div id="caixa">
 <h1>NEXUSBLATTER</h1><p>ANIME BATTLE ROYALE 3D</p><p>ESCOLHA SEU PERSONAGEM</p>
 <div id="seletores">
  <button class="heroi selecionado" data-heroi="0"><strong>⚡ NEXUS</strong>Energia azul</button>
  <button class="heroi" data-heroi="1"><strong>🔥 AKIRA</strong>Energia de fogo</button>
  <button class="heroi" data-heroi="2"><strong>❄️ KAI</strong>Energia de gelo</button>
  <button class="heroi" data-heroi="3"><strong>🌑 REN</strong>Energia sombria</button>
 </div>
 <p id="descricao">Guerreiro equilibrado e poderoso.</p><button id="jogar">ENTRAR NO JOGO</button>
</div></div>
<div id="aviso"></div>
<script type="module">
import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.187.0/build/three.module.js';

const cena=new THREE.Scene();
cena.background=new THREE.Color(0x8bc5e9);
cena.fog=new THREE.Fog(0x8bc5e9,100,205);
const camera=new THREE.PerspectiveCamera(65,innerWidth/innerHeight,.1,350);
const renderer=new THREE.WebGLRenderer({antialias:true,powerPreference:"high-performance"});
renderer.setPixelRatio(Math.min(devicePixelRatio,1.5));
renderer.setSize(innerWidth,innerHeight);
renderer.shadowMap.enabled=true;
renderer.shadowMap.type=THREE.PCFSoftShadowMap;
renderer.outputColorSpace=THREE.SRGBColorSpace;
renderer.toneMapping=THREE.ACESFilmicToneMapping;
renderer.toneMappingExposure=1.15;
document.body.appendChild(renderer.domElement);

cena.add(new THREE.HemisphereLight(0xc8eaff,0x52603a,2.1));
const sol=new THREE.DirectionalLight(0xfff1d1,2.6);
sol.position.set(-30,60,30);sol.castShadow=true;
sol.shadow.mapSize.set(1024,1024);sol.shadow.camera.left=-100;sol.shadow.camera.right=100;sol.shadow.camera.top=100;sol.shadow.camera.bottom=-100;cena.add(sol);

function mat(c,extra={}){return new THREE.MeshStandardMaterial({color:c,roughness:.78,...extra})}
const verde=mat(0x438c48),madeira=mat(0x71452c),folha=mat(0x287b3d),pele=mat(0xe5a77d),vidro=mat(0x62d8ff,{metalness:.3,roughness:.25});
const chao=new THREE.Mesh(new THREE.PlaneGeometry(210,210),verde);chao.rotation.x=-Math.PI/2;chao.receiveShadow=true;cena.add(chao);
const estradaMat=mat(0x555b63);
function estrada(x,z,w,d){const m=new THREE.Mesh(new THREE.BoxGeometry(w,.08,d),estradaMat);m.position.set(x,.04,z);cena.add(m)}
estrada(0,0,210,9);estrada(0,0,9,210);
for(let i=-90;i<=90;i+=9){if(i!==0){const faixa=new THREE.Mesh(new THREE.BoxGeometry(.18,.09,2.8),mat(0xe8dca0));faixa.position.set(i,.1,0);cena.add(faixa);}}
function casa(x,z,cor){
 const g=new THREE.Group(),parede=new THREE.Mesh(new THREE.BoxGeometry(7,4.5,6),mat(cor));
 parede.position.y=2.25;parede.castShadow=true;parede.receiveShadow=true;g.add(parede);
 const telhado=new THREE.Mesh(new THREE.ConeGeometry(5.2,2.8,4),mat(0x653b2c));telhado.position.y=5.8;telhado.rotation.y=Math.PI/4;telhado.castShadow=true;g.add(telhado);
 const porta=new THREE.Mesh(new THREE.BoxGeometry(1.2,2.5,.12),mat(0x49301e));porta.position.set(0,1.25,3.06);g.add(porta);
 const janela=new THREE.Mesh(new THREE.BoxGeometry(1.4,1.1,.13),vidro);janela.position.set(2,2.7,3.08);g.add(janela);
 g.position.set(x,0,z);cena.add(g);
}
[[-22,-22,0xd6b47d],[25,-29,0xc48bd8],[-34,28,0xd4d8e2],[35,30,0xd1a46e],[5,47,0x9eb7d5],[-52,-4,0xd6c18c],[55,-50,0xc9a3a0],[62,12,0xc6b18b],[-65,55,0xb5c9dc]].forEach(v=>casa(...v));
function arvore(x,z){
 const g=new THREE.Group(),tronco=new THREE.Mesh(new THREE.CylinderGeometry(.35,.55,3,8),madeira);
 tronco.position.y=1.5;g.add(tronco);
 const copa=new THREE.Mesh(new THREE.SphereGeometry(2.3,10,8),folha);copa.position.y=4;g.add(copa);
 const copa2=new THREE.Mesh(new THREE.SphereGeometry(1.6,8,8),mat(0x3a9b48));copa2.position.set(.8,4.7,.2);g.add(copa2);
 g.position.set(x,0,z);g.traverse(o=>{if(o.isMesh)o.castShadow=true});cena.add(g);
}
for(let i=0;i<155;i++){const x=(Math.random()-.5)*190,z=(Math.random()-.5)*190;if(Math.abs(x)<12||Math.abs(z)<12)continue;arvore(x,z)}
for(let i=0;i<45;i++){const r=new THREE.Mesh(new THREE.DodecahedronGeometry(1+Math.random()*1.5),mat(0x777e78));r.position.set((Math.random()-.5)*185,.5,(Math.random()-.5)*185);r.castShadow=true;cena.add(r)}

const herois=[
 {nome:"Nexus",cabelo:0x172c70,roupa:0x176ac9,poder:0x32efff,descricao:"Guerreiro equilibrado e poderoso.",vel:9,dano:1,especial:"Explosão elétrica"},
 {nome:"Akira",cabelo:0xc62b18,roupa:0xb93625,poder:0xff762b,descricao:"Guerreiro veloz com energia de fogo.",vel:10,dano:1,especial:"Chama em área"},
 {nome:"Kai",cabelo:0x83dfff,roupa:0x286bb5,poder:0x73eeff,descricao:"Guerreiro de gelo e precisão.",vel:9,dano:1.25,especial:"Rajada congelante"},
 {nome:"Ren",cabelo:0x231c35,roupa:0x45236d,poder:0xb46aff,descricao:"Guerreiro das sombras.",vel:8.5,dano:1.5,especial:"Pulso sombrio"}
];
function criarPersonagem(cabelo,roupa){
  // Modelo humanoide detalhado: formas suaves, roupas em camadas e rosto com expressão.
  const g=new THREE.Group();
  const roupaMat=mat(roupa,{roughness:.68});
  const roupaEscura=mat(0x202b3d,{roughness:.82});
  const cabeloMat=mat(cabelo,{roughness:.72});
  const peleMat=mat(0xe5a77d,{roughness:.88});
  const metal=mat(0xb8c8d5,{metalness:.62,roughness:.32});
  const brilho=mat(herois.find(h=>h.cabelo===cabelo)?.poder||0x55dfff,{emissive:herois.find(h=>h.cabelo===cabelo)?.poder||0x55dfff,emissiveIntensity:.42,metalness:.25,roughness:.35});
  const olho=mat(0x101323,{roughness:.28});
  const branco=mat(0xf4f7ff,{roughness:.35});
  function esfera(parent,m,x,y,z,sx,sy,sz){
    const o=new THREE.Mesh(new THREE.SphereGeometry(1,20,16),m);
    o.position.set(x,y,z);o.scale.set(sx,sy,sz);parent.add(o);return o;
  }
  function capsula(parent,m,r,l,x,y,z,rx=0,rz=0){
    const o=new THREE.Mesh(new THREE.CapsuleGeometry(r,l,6,12),m);
    o.position.set(x,y,z);o.rotation.set(rx,0,rz);parent.add(o);return o;
  }
  // Tronco, cintura e pescoço
  capsula(g,roupaMat,.43,.72,0,1.53,0);
  esfera(g,roupaMat,0,1.78,-.015,.49,.43,.34);
  esfera(g,roupaEscura,0,1.12,0,.34,.22,.29);
  const cintura=new THREE.Mesh(new THREE.CylinderGeometry(.32,.36,.13,20),metal);
  cintura.position.y=1.12;g.add(cintura);
  esfera(g,brilho,0,1.12,-.305,.075,.075,.035);
  const pescoco=new THREE.Mesh(new THREE.CylinderGeometry(.14,.17,.25,16),peleMat);
  pescoco.position.y=2.12;g.add(pescoco);
  // Cabeça e detalhes do rosto
  esfera(g,peleMat,0,2.48,-.015,.345,.425,.315);
  esfera(g,peleMat,-.35,2.48,-.005,.075,.12,.09);
  esfera(g,peleMat,.35,2.48,-.005,.075,.12,.09);
  // olhos, sobrancelhas e nariz voltados para a frente (-Z)
  for(const side of [-1,1]){
    esfera(g,branco,side*.135,2.51,-.294,.085,.052,.027);
    esfera(g,olho,side*.135,2.51,-.321,.038,.044,.018);
    esfera(g,olho,side*.135,2.61,-.292,.105,.025,.035);
  }
  esfera(g,peleMat,0,2.43,-.326,.045,.075,.045);
  const boca=new THREE.Mesh(new THREE.TorusGeometry(.055,.009,6,16,Math.PI),mat(0x783f42));
  boca.position.set(0,2.34,-.304);boca.rotation.z=Math.PI;g.add(boca);
  // Cabelo com volume e mechas individuais
  esfera(g,cabeloMat,0,2.78,-.005,.37,.23,.34);
  for(let i=0;i<9;i++){
    const ang=(i/9)*Math.PI*2;
    const p=new THREE.Mesh(new THREE.ConeGeometry(.105,.38+(i%3)*.07,8),cabeloMat);
    p.position.set(Math.sin(ang)*.25,2.88+(i%2)*.035,Math.cos(ang)*.22);
    p.rotation.z=Math.sin(ang)*-.65;p.rotation.x=Math.cos(ang)*.55;g.add(p);
  }
  // Jaqueta aberta, gola e detalhes do peito
  esfera(g,roupaEscura,0,1.83,-.31,.31,.31,.055);
  const gola1=capsula(g,metal,.065,.22,-.17,2.02,-.29,0,-.55);
  const gola2=capsula(g,metal,.065,.22,.17,2.02,-.29,0,.55);
  esfera(g,brilho,0,1.72,-.365,.095,.13,.035);
  // Ombreiras
  for(const side of [-1,1]){
    esfera(g,roupaEscura,side*.48,1.91,0,.22,.19,.23);
    esfera(g,metal,side*.49,1.96,-.035,.13,.055,.17);
  }
  // Braços articulados para a animação
  const bracos=[];
  for(const side of [-1,1]){
    const b=new THREE.Group();b.position.set(side*.53,1.91,0);g.add(b);
    esfera(b,roupaMat,0,-.08,0,.19,.2,.19);
    capsula(b,roupaMat,.145,.39,0,-.36,0,0,side*.06);
    esfera(b,metal,0,-.59,-.005,.155,.075,.16);
    capsula(b,peleMat,.115,.13,0,-.73,-.005);
    esfera(b,roupaEscura,0,-.79,-.025,.13,.105,.14);
    bracos.push(b);
  }
  // Pernas, joelheiras e botas
  const pernas=[];
  for(const side of [-1,1]){
    const perna=new THREE.Group();perna.position.set(side*.22,.99,0);g.add(perna);
    capsula(perna,roupaEscura,.17,.38,0,-.28,0);
    esfera(perna,metal,0,-.49,-.015,.18,.09,.18);
    capsula(perna,roupaEscura,.145,.34,0,-.69,0);
    esfera(perna,roupaMat,0,-.91,-.055,.18,.13,.25);
    esfera(perna,metal,0,-.91,-.245,.11,.045,.025);
    pernas.push(perna);
  }
  // Pequena capa/placa nas costas e emblema frontal
  esfera(g,roupaEscura,0,1.72,.31,.36,.42,.12);
  const emblema=new THREE.Mesh(new THREE.TorusGeometry(.105,.025,8,20),brilho);
  emblema.position.set(0,1.82,-.37);g.add(emblema);
  g.traverse(o=>{if(o.isMesh){o.castShadow=true;o.receiveShadow=true}});
  g.userData.bracos=bracos;g.userData.pernas=pernas;
  return g;
}
let personagemEscolhido=0;
let jogador=criarPersonagem(herois[0].cabelo,herois[0].roupa);cena.add(jogador);
const inimigos=[],cores=[0xbd344b,0x7135a8,0x282c43,0x9c5a27,0x287a72,0x8d3470];
for(let i=0;i<6;i++){const obj=criarPersonagem(0x252039,cores[i]),a=i*Math.PI/3;obj.position.set(Math.sin(a)*34,0,Math.cos(a)*34);cena.add(obj);inimigos.push({obj,vida:4,vivo:true,velocidade:2.7+Math.random()*1.1,proximoAtaque:0,fase:Math.random()*6,ataqueDistancia:2.2,congeladoAte:0})}

let pontos=0,vida=100,acabou=false,jogando=false,camYaw=0,joystickX=0,joystickY=0,velocidadeX=0,velocidadeZ=0;
let pulando=false,alturaPulo=0,velocidadeVertical=0,ultimoTempo=0,ultimoDisparo=0,ultimoEspecial=0,tempoJogo=0;
const projeteis=[],teclas={};
const $=id=>document.getElementById(id);
const barra=$("barraVida"),textoVida=$("vidaTexto"),textoPontos=$("pontos"),textoInimigos=$("inimigosTexto"),mensagem=$("mensagem"),aviso=$("aviso");
function atualizarHUD(){barra.style.width=Math.max(0,vida)+"%";textoVida.textContent=Math.max(0,Math.ceil(vida))+" / 100";textoPontos.textContent="Pontos: "+pontos;textoInimigos.textContent="Inimigos: "+inimigos.filter(e=>e.vivo).length}
let avisoTimer;function mostrarAviso(t){aviso.textContent=t;aviso.style.display="block";clearTimeout(avisoTimer);avisoTimer=setTimeout(()=>aviso.style.display="none",1250)}
document.querySelectorAll(".heroi").forEach(btn=>btn.addEventListener("click",()=>{personagemEscolhido=Number(btn.dataset.heroi);document.querySelectorAll(".heroi").forEach(b=>b.classList.remove("selecionado"));btn.classList.add("selecionado");$("descricao").textContent=herois[personagemEscolhido].descricao}));
function trocarVisual(){
 const h=herois[personagemEscolhido],novo=criarPersonagem(h.cabelo,h.roupa);
 novo.position.copy(jogador.position);novo.rotation.copy(jogador.rotation);novo.position.y=alturaPulo;
 cena.remove(jogador);jogador=novo;cena.add(jogador);$("personagemNome").textContent="Herói: "+h.nome;
}
function atingirInimigo(e,dano){
 if(!e.vivo)return;e.vida-=dano;
 if(e.vida<=0){e.vivo=false;e.obj.visible=false;pontos+=100;mostrarAviso("Adversário derrotado! +100")}
 else{pontos+=10}
 atualizarHUD();if(inimigos.every(x=>!x.vivo))finalizar(true);
}
function disparar(){
 if(!jogando||acabou)return;const agora=performance.now();if(agora-ultimoDisparo<360)return;ultimoDisparo=agora;
 let alvo=null,menor=42;for(const e of inimigos){if(!e.vivo)continue;const d=jogador.position.distanceTo(e.obj.position);if(d<menor){menor=d;alvo=e}}
 if(!alvo){mostrarAviso("Nenhum adversário no alcance!");return}
 const cor=herois[personagemEscolhido].poder,bola=new THREE.Mesh(new THREE.SphereGeometry(.27,14,12),mat(cor,{emissive:cor,emissiveIntensity:2.8}));
 bola.position.copy(jogador.position);bola.position.y+=1.8;cena.add(bola);projeteis.push({obj:bola,alvo,dano:herois[personagemEscolhido].dano});
}
function poderEspecial(){
 if(!jogando||acabou)return;const agora=performance.now();if(agora-ultimoEspecial<6500){mostrarAviso("Poder recarregando!");return}ultimoEspecial=agora;
 const h=herois[personagemEscolhido],cor=h.poder;
 const onda=new THREE.Mesh(new THREE.TorusGeometry(2.5,.16,8,36),mat(cor,{emissive:cor,emissiveIntensity:2.5}));
 onda.rotation.x=Math.PI/2;onda.position.copy(jogador.position);onda.position.y=.35;cena.add(onda);
 let acertou=0;for(const e of inimigos){if(e.vivo&&e.obj.position.distanceTo(jogador.position)<12){atingirInimigo(e,personagemEscolhido===2?2:3);if(personagemEscolhido===2)e.congeladoAte=agora/1000+2;acertou++}}
 setTimeout(()=>cena.remove(onda),350);mostrarAviso(acertou?h.especial+"!":"Poder ativado!");
}
function atualizarProjeteis(dt){
 for(let i=projeteis.length-1;i>=0;i--){const p=projeteis[i];if(!p.alvo.vivo){cena.remove(p.obj);projeteis.splice(i,1);continue}
 const destino=p.alvo.obj.position.clone();destino.y+=1.5;const dir=destino.clone().sub(p.obj.position),dist=dir.length();
 if(dist<.9){atingirInimigo(p.alvo,p.dano);cena.remove(p.obj);projeteis.splice(i,1);continue}
 dir.normalize();p.obj.position.addScaledVector(dir,39*dt);
 }
}
function atualizarJogador(dt){
 const forward=new THREE.Vector3(Math.sin(camYaw),0,-Math.cos(camYaw)),right=new THREE.Vector3(Math.cos(camYaw),0,Math.sin(camYaw)),mov=new THREE.Vector3();
 mov.addScaledVector(forward,-joystickY);mov.addScaledVector(right,joystickX);
 let kx=0,ky=0;if(teclas.w||teclas.arrowup)ky-=1;if(teclas.s||teclas.arrowdown)ky+=1;if(teclas.a||teclas.arrowleft)kx-=1;if(teclas.d||teclas.arrowright)kx+=1;
 mov.addScaledVector(forward,-ky);mov.addScaledVector(right,kx);if(mov.length()>1)mov.normalize();
 const h=herois[personagemEscolhido],s=Math.min(1,dt*12);
 velocidadeX=THREE.MathUtils.lerp(velocidadeX,mov.x*h.vel,s);velocidadeZ=THREE.MathUtils.lerp(velocidadeZ,mov.z*h.vel,s);
 jogador.position.x=THREE.MathUtils.clamp(jogador.position.x+velocidadeX*dt,-98,98);
 jogador.position.z=THREE.MathUtils.clamp(jogador.position.z+velocidadeZ*dt,-98,98);
 const andando=mov.length()>.1;if(andando)jogador.rotation.y=Math.atan2(-mov.x,-mov.z);
 const passo=andando?Math.sin(tempoJogo*11)*.58:0;
 jogador.userData.pernas?.forEach((p,i)=>p.rotation.x=i===0?passo:-passo);
 jogador.userData.bracos?.forEach((b,i)=>b.rotation.x=i===0?-passo:passo);
 if(pulando){velocidadeVertical-=21*dt;alturaPulo+=velocidadeVertical*dt;if(alturaPulo<=0){alturaPulo=0;velocidadeVertical=0;pulando=false}}
 jogador.position.y=alturaPulo;
