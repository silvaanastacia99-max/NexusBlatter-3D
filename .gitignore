function atualizarInimigos(dt){
 const agora=performance.now()/1000;
 for(const e of inimigos){if(!e.vivo)continue;const o=e.obj,dx=jogador.position.x-o.position.x,dz=jogador.position.z-o.position.z,dist=Math.hypot(dx,dz);
 if(agora<e.congeladoAte)continue;
 if(dist>e.ataqueDistancia){const lado=Math.sin(tempoJogo*1.8+e.fase)*.22,nx=dx/(dist||1),nz=dz/(dist||1);o.position.x+=(nx-lado*nz)*e.velocidade*dt;o.position.z+=(nz+lado*nx)*e.velocidade*dt;o.rotation.y=Math.atan2(-dx,-dz)}
 else if(agora>e.proximoAtaque){vida=Math.max(0,vida-4);e.proximoAtaque=agora+1.8;atualizarHUD();mostrarAviso("Você recebeu um ataque!");if(vida<=0)finalizar(false)}
 const passo=dist>e.ataqueDistancia?Math.sin(tempoJogo*8+e.fase)*.45:0;o.userData.pernas?.forEach((p,i)=>p.rotation.x=i===0?passo:-passo);
 }
}
function atualizarCamera(dt){
 const distancia=7.8,altura=4.2,alvo=new THREE.Vector3(jogador.position.x-Math.sin(camYaw)*distancia,jogador.position.y+altura,jogador.position.z+Math.cos(camYaw)*distancia);
 camera.position.lerp(alvo,1-Math.exp(-dt*6));camera.lookAt(jogador.position.x,jogador.position.y+1.55,jogador.position.z);
}
