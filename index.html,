    vida=Math.max(0,vida-5);
    e.espera=0;
    atualizarHUD();
    if(vida<=0)finalizar(false);
   }
  }
 }

 for(let i=projeteis.length-1;i>=0;i--){
  const p=projeteis[i];
  if(!p.alvo.vivo){
   cena.remove(p.obj);projeteis.splice(i,1);continue;
  }
  const destino=p.alvo.obj.position.clone();
  destino.y+=1.5;
