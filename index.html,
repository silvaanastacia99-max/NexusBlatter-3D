  const distancia=v.length();
  if(distancia<.7||p.tempo>1.2){
   atingirInimigo(p.alvo);
   cena.remove(p.obj);
   projeteis.splice(i,1);
  }else{
   p.obj.position.addScaledVector(v.normalize(),22*dt);
   p.tempo+=dt;
  }
 }

 const alvoCamera=jogador.position.clone();
 alvoCamera.y+=2.5;
 const atras=new THREE.Vector3(0,5,-9);
 atras.applyAxisAngle(new THREE.Vector3(0,1,0),jogador.rotation.y);
 const cameraPos=jogador.position.clone().add(atras);
 camera.position.lerp(cameraPos,Math.min(1,dt*5));
 camera.lookAt(alvoCamera);
}

function animar(){
